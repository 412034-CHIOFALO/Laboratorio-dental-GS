# ─── Configuración del bot de WhatsApp GS ───────────────────────────
# Copiá este archivo como ".env" y completá los valores.

# URL del backend (api-gateway). En dev local: http://localhost:8080
BACKEND_URL=http://localhost:8080

# ¿Pegarle al backend de verdad?
#   false → el bot SOLO loguea lo que detecta (ideal para la primera prueba)
#   true  → el bot registra los pagos en el sistema
BACKEND_ENABLED=false

# API key del bot para autenticar contra el backend (NO expira).
# Tiene que coincidir con GS_BOT_API_KEY de ms-finanzas.
# Solo necesario si BACKEND_ENABLED=true.
BOT_API_KEY=gs-bot-dev-key-cambiar-en-prod

# Nombre(s) de los grupos a escuchar, separados por coma.
# Dejalo vacío para escuchar TODOS los grupos donde esté el bot.
GRUPOS=Comprobantes Transferencias,Comprobantes Efectivo

# ─── Gemini (IA para leer comprobantes de cualquier billetera) ────────
# API key de https://aistudio.google.com/apikey (empieza con "AIza...")
GEMINI_API_KEY=

# true  → usa IA para leer los comprobantes (cualquier billetera + fotos)
# false → usa solo las reglas locales (PDF de MP/Personal Pay)
GEMINI_ENABLED=false

# Modelo a usar. Si "gemini-2.0-flash" da error 404, listá los disponibles con:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=TU_API_KEY"
# y poné uno de la lista (ej: gemini-2.5-flash, gemini-flash-latest).
GEMINI_MODEL=gemini-2.0-flash

# ─── Scraper de mails (pedidos recibidos por email) ───────────────────────────
# Activar el scraper:
#   false → desactivado (default)
#   true  → monitorea la casilla y crea pedidos automáticamente
MAIL_ENABLED=false

# Cuenta IMAP que el laboratorio usa para recibir pedidos de los odontólogos.
# Gmail: activá "Contraseña de aplicación" en la cuenta (no uses la contraseña normal).
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=true
MAIL_IMAP_USER=laboratorio@gmail.com
MAIL_IMAP_PASSWORD=tu-contrasena-de-aplicacion

# SMTP para enviarle la confirmación de pedido al odontólogo.
# Podés usar la misma cuenta que IMAP.
# Si no configurás esto, el bot procesa los emails pero no responde.
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
# MAIL_SMTP_USER=laboratorio@gmail.com     # hereda de MAIL_IMAP_USER si se omite
# MAIL_SMTP_PASSWORD=contrasena-smtp       # hereda de MAIL_IMAP_PASSWORD si se omite

# Usuario del sistema GS con rol ADMINISTRATIVO que el scraper usa para crear pedidos.
# ms-auth lo crea solo al arrancar (DataInitializer); la pass debe coincidir con
# GS_BOT_PEDIDOS_PASSWORD de ms-auth.
BOT_PEDIDOS_USER=bot-pedidos
BOT_PEDIDOS_PASSWORD=cambiar-en-produccion

# Intervalo de chequeo de la casilla (en segundos). Default: 120 (cada 2 minutos).
MAIL_POLL_INTERVAL=120
