# ─── Configuración del bot de WhatsApp GS ───────────────────────────
# Copiá este archivo como ".env" y completá los valores.

# URL del backend (api-gateway). En dev local: http://localhost:8080
BACKEND_URL=http://localhost:8080

# ¿Pegarle al backend de verdad?
#   false → el bot SOLO loguea lo que detecta (ideal para la primera prueba)
#   true  → el bot registra los pagos en el sistema
BACKEND_ENABLED=false

# API key del bot para autenticar contra el backend (NO expira).
# Tiene que coincidir con GS_BOT_API_KEY de ms-finanzas.
# Solo necesario si BACKEND_ENABLED=true.
BOT_API_KEY=gs-bot-dev-key-cambiar-en-prod

# Nombre(s) de los grupos a escuchar, separados por coma.
# Dejalo vacío para escuchar TODOS los grupos donde esté el bot.
GRUPOS=Comprobantes Transferencias,Comprobantes Efectivo

# ─── Gemini (IA para leer comprobantes de cualquier billetera) ────────
# API key de https://aistudio.google.com/apikey (empieza con "AIza...")
GEMINI_API_KEY=

# true  → usa IA para leer los comprobantes (cualquier billetera + fotos)
# false → usa solo las reglas locales (PDF de MP/Personal Pay)
GEMINI_ENABLED=false

# Modelo a usar. Si "gemini-2.0-flash" da error 404, listá los disponibles con:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=TU_API_KEY"
# y poné uno de la lista (ej: gemini-2.5-flash, gemini-flash-latest).
GEMINI_MODEL=gemini-2.0-flash
