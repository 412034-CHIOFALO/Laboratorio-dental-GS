# =============================================================
#  ERP G&S — Plantilla de variables de entorno
#  Copiar como ".env" y completar con valores reales.
#  Este archivo SÍ se commitea a Git (sin contraseñas reales).
# =============================================================

# --- Base de datos MySQL ---
MYSQL_ROOT_PASSWORD=cambiar_este_password

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=cambiar_este_password

# --- RabbitMQ ---
RABBITMQ_USER=gys_rabbit
RABBITMQ_PASSWORD=cambiar_este_password

# --- MinIO ---
MINIO_ROOT_USER=gys_minio_admin
MINIO_ROOT_PASSWORD=cambiar_este_password

# --- Usuarios iniciales de ms-auth ---
GYS_ADMIN_PASSWORD=cambiar_este_password
GYS_TECNICO_PASSWORD=cambiar_este_password

# --- JWT ---
JWT_JWK_URI=http://localhost:8081/oauth2/jwks

# --- RSA Keystore (ms-auth) ---
GYS_KEYSTORE_PASSWORD=cambiar_este_password
