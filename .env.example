# =============================================================
#  ERP G&S — Variables de entorno (EJEMPLO)
#
#  Copiá este archivo como .env y completá los valores reales.
#  NUNCA commitees el .env con credenciales reales a Git.
# =============================================================

# ─── Base de datos MySQL ──────────────────────────────────────
MYSQL_ROOT_PASSWORD=cambiar_por_contraseña_segura

DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=cambiar_por_contraseña_segura

# ─── MinIO (almacenamiento de comprobantes y documentos) ──────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=cambiar_por_contraseña_segura

# Los archivos (documentos, escaneos, comprobantes) se sirven en streaming a
# traves del propio backend via el gateway; MinIO nunca se expone al browser.

# Bucket de comprobantes de finanzas (default: comprobantes)
# MINIO_BUCKET=comprobantes

# Bucket de documentos adjuntos a pedidos (default: documentos-pedidos)
# MINIO_BUCKET_DOCS=documentos-pedidos

# ─── Usuarios iniciales (se crean al primer arranque de ms-auth) ──
GS_ADMIN_PASSWORD=contraseña_admin_min_8_chars
GS_TECNICO_PASSWORD=contraseña_tecnico_min_8_chars

# ─── JWT ──────────────────────────────────────────────────────
# En local, apunta directo a ms-auth.
# En Docker, usar el nombre del servicio: http://ms-auth:8081/oauth2/jwks
JWT_JWK_URI=http://localhost:8081/oauth2/jwks

# ─── RSA Keystore (ms-auth) ───────────────────────────────────
# Contraseña del archivo gs-auth.p12 (src/main/resources/keys/)
# En producción: cambiar y usar un keystore diferente.
GS_KEYSTORE_PASSWORD=contraseña_keystore_segura

# ─── Bot de WhatsApp ──────────────────────────────────────────
# URL del gateway que usa el bot para registrar pagos.
# En Docker: http://api-gateway:8080
BACKEND_URL=http://localhost:8080

# true  → registra pagos en el sistema ERP
# false → solo muestra en consola (modo debug)
BACKEND_ENABLED=true

# Clave compartida bot ↔ backend. Debe ser larga y aleatoria.
# Generar con: openssl rand -hex 32
GS_BOT_API_KEY=reemplazar_por_clave_aleatoria_larga
BOT_API_KEY=reemplazar_por_clave_aleatoria_larga

# Puerto HTTP del bot (panel de estado + QR). Default: 3001
BOT_HTTP_PORT=3001

# En Docker, ms-pedidos también necesita saber la URL del bot para notificar LISTO
# BOT_URI=http://gs-bot:3001

# Grupos de WhatsApp que escucha el bot (separados por coma, case-insensitive).
# Vacío = escucha TODOS los grupos (útil en dev, no recomendado en prod).
# Ejemplo: GRUPOS=Comprobantes Transferencias,Comprobantes Efectivo
GRUPOS=

# Mapeo manual "nombre:jid" (opcional, separados por coma) para que el bot
# identifique los grupos SIN depender de una llamada en vivo a WhatsApp Web
# (getChats/getChatById) — esa llamada es la que se rompe cada vez que
# WhatsApp cambia algo de su lado ("r: r" en los logs) y deja al bot sin
# poder procesar NINGÚN mensaje hasta que whatsapp-web.js lo parchea. Con
# esto seteado, el bot no vuelve a depender de que esa llamada funcione.
# Cómo conseguir el jid: cuando el bot no reconoce un grupo, loguea el jid
# exacto del mensaje que llegó ahí — copiá esa línea acá.
# Ejemplo: BOT_GRUPOS_JIDS=Comprobantes Transferencias:120363012345678901@g.us,Comprobantes Efectivo:120363019876543210@g.us
BOT_GRUPOS_JIDS=

# ─── Gemini AI (lectura de comprobantes con IA) ───────────────
# Obtener clave en: https://aistudio.google.com/app/apikey
# Si está vacío o GEMINI_ENABLED=false, se usa solo Tesseract OCR.
GEMINI_API_KEY=
GEMINI_ENABLED=false
GEMINI_MODEL=gemini-2.5-flash

# ─── Reglas de negocio (opcionales — tienen defaults) ─────────
# Días hábiles sin avanzar para marcar un pedido como "atrasado" (default: 6)
# GS_DIAS_LIMITE_ATRASO=6

# ─── Scraper de mails (crea pedidos desde emails via IMAP + Gemini) ───
# OFF por defecto. Requiere GEMINI_API_KEY configurado arriba.
# Con Gmail: hay que habilitar IMAP (Configuración > Ver toda la config >
# Reenvío y POP/IMAP > Habilitar IMAP) y usar una "contraseña de aplicación"
# (myaccount.google.com/apppasswords) en vez de la contraseña normal, ya
# que la cuenta tiene verificación en 2 pasos.
MAIL_ENABLED=false
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=true
MAIL_IMAP_USER=
MAIL_IMAP_PASSWORD=
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
# Segundos entre cada chequeo de la casilla (default 120)
MAIL_POLL_INTERVAL=120
# Ciclos seguidos abortados antes de que el proceso se reinicie solo (default 8)
MAIL_MAX_FALLOS_CONSECUTIVOS=8
